{
    "title": "Heart Disease API",
    "uid": "heart-api",
    "schemaVersion": 39,
    "refresh": "5s",
    "time": { "from": "now-15m", "to": "now" },
    "panels": [
        {
            "id": 1,
            "type": "timeseries",
            "title": "Requests per second",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
            "targets": [
                {
                    "expr": "sum by (path) (rate(api_requests_total[1m]))",
                    "legendFormat": "{{path}}",
                    "refId": "A"
                }
            ],
            "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
            "id": 2,
            "type": "timeseries",
            "title": "p95 latency (s)",
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum by (le, path) (rate(api_request_latency_seconds_bucket[1m])))",
                    "legendFormat": "{{path}}",
                    "refId": "A"
                }
            ],
            "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
            "id": 3,
            "type": "piechart",
            "title": "Predictions by label",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
            "targets": [
                {
                    "expr": "sum by (label) (api_predictions_total)",
                    "legendFormat": "{{label}}",
                    "refId": "A"
                }
            ],
            "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
            "id": 4,
            "type": "stat",
            "title": "5xx errors / prediction failures",
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
            "targets": [
                {
                    "expr": "sum(api_prediction_errors_total) or vector(0)",
                    "refId": "A"
                }
            ],
            "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
    ]
}
